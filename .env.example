# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL. The app owns database `hub` only.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hub?schema=public"

# Session cookie signing key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# LINE Login channel (used by both LIFF and the browser login)
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""

# LIFF app id for the LINE in-app browser
LIFF_ID=""

# Messaging API channel access token of the company Official Account
LINE_MESSAGING_TOKEN=""

# Absolute path outside the web root for uploaded attachments
FILE_STORAGE_PATH="D:\\hub-data\\attachments"

# Public origin, used for LINE callbacks and push message links
APP_ORIGIN="http://localhost:3000"

# Phone lock-screen alerts. Leave empty to keep them off.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hub@scharoenchai.cloud"

# Bootstrap System Admin fallback login. Remove after the first real admin exists.
BOOTSTRAP_ADMIN_EMPLOYEE_CODE="admin"
BOOTSTRAP_ADMIN_PASSWORD=""
